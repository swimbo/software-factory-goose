# REVIEW DRAFT: explicit operator-caller policy; activation and key custody unverified.
# REVIEW DRAFT: root-protected stop key must be separately provisioned.
[Unit]
Description=Software Factory nonroot brake frontend
Requires=software-factory-goose-brake.socket
After=software-factory-goose-brake.socket
[Service]
Type=simple
User=sfgoose-brake
Group=sfgoose-brake
ExecStart=/usr/local/libexec/software-factory-goose/sfactory_brake_frontend
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
