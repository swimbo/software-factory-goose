+// Backported from aaif-goose/goose 9949cf926cd42f1d128b9991ed23a496ecace896.
+// Keep interactive recovery behavior; propagate terminal failure from headless runs.
+fn headless_run_error(
+    interactive: bool,
+    cancelled: bool,
+    stream_error: Option<anyhow::Error>,
+    messages: &Conversation,
+) -> Option<anyhow::Error> {
+    if interactive {
+        return None;
+    }
+
+    stream_error
+        .or_else(|| cancelled.then(|| anyhow::anyhow!("Headless run interrupted")))
+        .or_else(|| {
+            messages
+                .last()
+                .and_then(|message| message.content.iter().find_map(MessageContent::as_error))
+                .map(|error| anyhow::anyhow!(error.message.clone()))
+        })
+}
