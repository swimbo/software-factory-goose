{
  "$id": "urn:software-factory:legacy-shape:credential-grant:v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CredentialKind": {
      "oneOf": [
        {
          "description": "Low-stakes, self-issued (agent-mail channel).",
          "enum": [
            "self_issued"
          ],
          "type": "string"
        },
        {
          "description": "Broker-issued short-lived token (model gateway virtual key).",
          "enum": [
            "broker_issued"
          ],
          "type": "string"
        },
        {
          "description": "Privileged/destructive class — always human-approved.",
          "enum": [
            "privileged"
          ],
          "type": "string"
        }
      ]
    }
  },
  "description": "A credential grant issued by the broker. The *reference* is stored; the secret value never appears in this record (or in any agent context).",
  "properties": {
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "human_approval_required": {
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "type": "string"
    },
    "kind": {
      "$ref": "#/definitions/CredentialKind"
    },
    "scope": {
      "description": "single-repo, single-action scope (e.g. `git:push:agent/<wp>`).",
      "type": "string"
    },
    "ttl_secs": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "work_package_id": {
      "type": "string"
    }
  },
  "required": [
    "expires_at",
    "human_approval_required",
    "id",
    "issued_at",
    "kind",
    "scope",
    "ttl_secs",
    "work_package_id"
  ],
  "title": "CredentialGrant",
  "type": "object"
}
