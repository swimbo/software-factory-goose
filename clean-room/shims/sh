#!/bin/sh
# Optional PATH interception only. Absolute shells, built-in tools, and interpreters bypass
# this shim; it cannot establish R13/R14 without mandatory tool integration and OS isolation.
# Refuse unsupported shell forms instead of falling through to an unguarded /bin/sh.
if [ "$#" -ne 2 ] || [ "$1" != "-c" ]; then
  echo 'policy: only sh -c <command> is supported' >&2
  exit 126
fi
if [ -z "${SFACTORY_EXECUTION_BIN:-}" ]; then
  echo 'policy: SFACTORY_EXECUTION_BIN must be configured' >&2
  exit 126
fi
exec "$SFACTORY_EXECUTION_BIN" --run-shell "$2"
